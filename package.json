{
  "name": "chatty-voice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Voice-only chat in the browser: Whistle hears, Qwen3 0.6B EN answers, Piper speaks. Everything on the device.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
